<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pro_bg_deep"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configure Desktop Session"
        android:textColor="@color/pro_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <!-- Distro Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Linux Distribution"
        android:textColor="@color/pro_text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:paddingBottom="8dp" />

    <!-- Distro Spinner Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/pro_bg_card"
        app:cardCornerRadius="12dp"
        app:strokeColor="@color/pro_bg_card_highlight"
        app:strokeWidth="1dp">

        <Spinner
            android:id="@+id/spinner_distro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Desktop Environment Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Desktop Environment"
        android:textColor="@color/pro_text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:paddingBottom="8dp" />

    <!-- DE Spinner Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardBackgroundColor="@color/pro_bg_card"
        app:cardCornerRadius="12dp"
        app:strokeColor="@color/pro_bg_card_highlight"
        app:strokeWidth="1dp">

        <Spinner
            android:id="@+id/spinner_de"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
