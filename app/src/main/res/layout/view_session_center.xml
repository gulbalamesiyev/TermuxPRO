<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/near_black"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/navy"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/session_center_menu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/menu"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/termux_pro"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Section Caption -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:paddingHorizontal="16dp"
        android:text="@string/active_sessions"
        android:textColor="@color/muted_gray"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <!-- Session List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/session_center_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- New Session Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/session_center_new_session"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="@string/new_session"
        android:textColor="@color/terminal_green"
        android:visibility="visible"
        android:enabled="true"
        app:backgroundTint="@color/near_black"
        app:strokeColor="@color/terminal_green"
        app:strokeWidth="1dp"
        app:cornerRadius="8dp" />

</LinearLayout>
