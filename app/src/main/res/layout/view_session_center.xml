<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pro_bg_deep"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/pro_bg_deep"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/session_center_menu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/menu"
            app:tint="@color/pro_cyan" />

        <TextView
            android:id="@+id/session_center_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/application_name_no_pro"
            android:textColor="@color/pro_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

    </RelativeLayout>

    <!-- Tabs: Terminal & Desktop -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tab_terminal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Terminal"
            android:textColor="@color/pro_cyan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tab_desktop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Desktop"
            android:textColor="@color/pro_text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- Session List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/session_center_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- New Session Button for Terminal Tab -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/session_center_new_session_terminal"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="New Terminal Session"
        android:textColor="@color/black"
        android:visibility="visible"
        app:backgroundTint="@color/pro_cyan"
        app:cornerRadius="16dp" />

    <!-- New Session / Start Desktop Button for Desktop Tab -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/session_center_new_session_desktop"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="New Desktop Session"
        android:textColor="@color/black"
        android:visibility="gone"
        app:backgroundTint="@color/pro_cyan"
        app:cornerRadius="16dp" />

</LinearLayout>
