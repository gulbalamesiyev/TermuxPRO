<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Soft Cross-Fade Animation for All Activity Transitions -->
    <style name="FadeActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- Base Material 3 Theme -->
    <style name="Theme.TermuxApp.DayNight.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pro_cyan</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorContainer">@color/pro_bg_card</item>
        <item name="android:windowBackground">@color/pro_bg_deep</item>
        <item name="android:navigationBarColor">@color/pro_bg_deep</item>
        <item name="android:statusBarColor">@color/pro_bg_deep</item>
        <item name="android:windowAnimationStyle">@style/FadeActivityAnimation</item>
    </style>

    <style name="Theme.TermuxApp.DayNight.DarkActionBar" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/pro_cyan</item>
        <item name="android:windowBackground">@color/pro_bg_deep</item>
        <item name="android:windowAnimationStyle">@style/FadeActivityAnimation</item>
    </style>

    <!-- TermuxActivity Pro Theme -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/pro_cyan</item>
        <item name="colorSecondary">@color/pro_cyan_dim</item>

        <item name="android:windowBackground">@color/pro_bg_deep</item>

        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Enable Edge-to-Edge -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowAnimationStyle">@style/FadeActivityAnimation</item>

        <!-- Left drawer -->
        <item name="termuxActivityDrawerBackground">@color/pro_bg_deep</item>
        <item name="termuxActivityDrawerImageTint">@color/pro_cyan</item>

        <!-- Extra keys colors -->
        <item name="extraKeysButtonTextColor">@color/pro_text_primary</item>
        <item name="extraKeysButtonActiveTextColor">@color/pro_cyan</item>
        <item name="extraKeysButtonBackgroundColor">@color/pro_bg_card</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/pro_bg_card_highlight</item>

        <!-- Custom Styles -->
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Filled</item>
        <item name="alertDialogTheme">@style/Theme.TermuxPro.Dialog</item>
    </style>

    <!-- SD Maid SE / Material 3 Dark Custom Dialog Theme -->
    <style name="Theme.TermuxPro.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@drawable/dialog_background_rounded</item>
        <item name="colorSurface">@color/pro_bg_card</item>
        <item name="colorOnSurface">@color/pro_text_primary</item>
        <item name="colorPrimary">@color/pro_cyan</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColorPrimary">@color/pro_text_primary</item>
        <item name="android:textColorSecondary">@color/pro_text_secondary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TermuxPro.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.TermuxPro.Button.Dialog.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.TermuxPro.Button.Dialog.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.TermuxPro.Button.Dialog.Negative</item>
    </style>

    <style name="ShapeAppearance.TermuxPro.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.TermuxPro.Button.Dialog.Positive" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/dialog_button_positive</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.TermuxPro.Button.Dialog.Negative" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/dialog_button_negative</item>
        <item name="android:textColor">@color/pro_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
