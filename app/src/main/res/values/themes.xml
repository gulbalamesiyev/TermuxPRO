<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Material 3 Theme -->
    <style name="Theme.TermuxApp.DayNight.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pro_cyan</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorContainer">@color/pro_bg_card</item>
        <item name="android:windowBackground">@color/pro_bg_deep</item>
        <item name="android:navigationBarColor">@color/pro_bg_deep</item>
        <item name="android:statusBarColor">@color/pro_bg_deep</item>
    </style>

    <style name="Theme.TermuxApp.DayNight.DarkActionBar" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/pro_cyan</item>
        <item name="android:windowBackground">@color/pro_bg_deep</item>
    </style>

    <!-- TermuxActivity Pro Theme -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/pro_cyan</item>
        <item name="colorSecondary">@color/pro_cyan_dim</item>

        <item name="android:windowBackground">@color/pro_bg_deep</item>

        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Enable Edge-to-Edge -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Left drawer -->
        <item name="termuxActivityDrawerBackground">@color/pro_bg_deep</item>
        <item name="termuxActivityDrawerImageTint">@color/pro_cyan</item>

        <!-- Extra keys colors -->
        <item name="extraKeysButtonTextColor">@color/pro_text_primary</item>
        <item name="extraKeysButtonActiveTextColor">@color/pro_cyan</item>
        <item name="extraKeysButtonBackgroundColor">@color/pro_bg_card</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/pro_bg_card_highlight</item>

        <!-- Custom Styles -->
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Filled</item>
    </style>

</resources>
